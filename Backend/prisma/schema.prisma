generator client {
  provider      = "prisma-client-js"
  // Explicit targets so the query engine loads on Alpine/musl (Render Docker)
  // as well as local dev — otherwise the engine fails to load at runtime.
  binaryTargets = ["native", "linux-musl-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  ATTENDEE
  ORGANIZER
  ADMIN
}

enum UserTier {
  FREE
  FOUNDER
}

enum CardStatus {
  PENDING
  ACTIVE
  DEACTIVATED
  REJECTED
}

enum ConnectionStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum EventStatus {
  DRAFT
  PUBLISHED
  PAUSED
  CANCELLED
  COMPLETED
}

enum PayoutStatus {
  PENDING
  PAID
}

enum EventType {
  IN_PERSON
  VIRTUAL
  HYBRID
}

enum EventVisibility {
  PUBLIC
  PRIVATE
  UNLISTED
}

enum RegistrationStatus {
  REGISTERED
  ATTENDED
  CANCELLED
  WAITLISTED
  PENDING_APPROVAL
}

enum NotificationType {
  CONNECTION_REQUEST
  CONNECTION_ACCEPTED
  EVENT_REMINDER
  FOUNDER_CARD_APPROVED
  FOUNDER_CARD_REJECTED
  NEW_EVENT
  BADGE_EARNED
  LEVEL_UP
  CARD_VIEWED
  REGISTRATION_APPROVED
  SYSTEM
}

enum PaymentStatus {
  CREATED
  PAID
  FAILED
  REFUNDED
}

enum LeadStatus {
  NEW
  CONTACTED
  QUALIFIED
  CONVERTED
  ARCHIVED
}

enum EventRole {
  ATTENDEE
  VIP
  SPEAKER
  STAFF
  SPONSOR
}

enum ReportTargetType {
  USER
  EVENT
  CONNECTION
  COMMENT
}

enum ReportStatus {
  OPEN
  REVIEWING
  ACTIONED
  DISMISSED
}

enum TapMethod {
  QR
  NFC
  MANUAL
}

enum FulfillmentStatus {
  PENDING
  DISPATCHED
  DELIVERED
}

/// Founder membership (recurring subscription) lifecycle.
/// ACTIVE       — paid & current.
/// CANCELLED    — cancelled but still entitled until currentPeriodEnd.
/// HALTED       — a recurring charge failed; Razorpay paused the subscription.
/// EXPIRED      — period ended without renewal.
enum MembershipStatus {
  NONE
  ACTIVE
  CANCELLED
  HALTED
  EXPIRED
}

model User {
  id              String    @id @default(uuid())
  email           String    @unique
  username        String?   @unique
  password        String?
  supabaseId      String?   @unique
  googleId        String?   @unique
  authProvider    String    @default("email")
  role            Role      @default(ATTENDEE)
  tier            UserTier  @default(FREE)
  isActive        Boolean   @default(true)
  isEmailVerified Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  profile             Profile?
  founderCard         FounderCard?
  gamification        Gamification?
  sentConnections     Connection[]        @relation("Requester")
  receivedConnections Connection[]        @relation("Receiver")
  registrations       EventRegistration[]
  organizedEvents     Event[]             @relation("Organizer")
  notifications       Notification[]
  userBadges          UserBadge[]
  scoreHistory        ScoreHistory[]
  leads               Lead[]              @relation("AttendeeLead")
  organizedLeads      Lead[]              @relation("OrganizerLead")
  auditLogs           AuditLog[]
  refreshTokens       RefreshToken[]
  passwordResetTokens PasswordResetToken[]
  eventMessages       EventMessage[]
  reportsFiled        Report[]            @relation("ReportsFiled")
  reportsReviewed     Report[]            @relation("ReportsReviewed")
  tapsInitiated       EventTap[]          @relation("TapsInitiated")
  tapsReceived        EventTap[]          @relation("TapsReceived")
  claimTokens         ClaimToken[]
  connectionNotes     ConnectionNote[]
  savedEvents         SavedEvent[]
  conversationsAsA    Conversation[]      @relation("ConvUserA")
  conversationsAsB    Conversation[]      @relation("ConvUserB")
  messagesSent        Message[]
  coorganizedEvents   EventCoorganizer[]
  pageViews           EventPageView[]
  payments            Payment[]
  cardPurchases       CardPurchase[]
  cardViewsReceived   CardView[]          @relation("CardViewsReceived")
  cardViewsMade       CardView[]          @relation("CardViewsMade")
  connectionMeta      ConnectionMeta[]
  cardBlocks          CardBlock[]
  cardLeads           CardLead[]          @relation("CardLeadsReceived")
  payouts             Payout[]
  blocksMade          BlockedUser[]       @relation("BlocksMade")
  blocksReceived      BlockedUser[]       @relation("BlocksReceived")
  membership          Membership?
  ownedCommunities    Community[]         @relation("CommunityOwner")
  communityMemberships CommunityMember[]
  communityPosts      CommunityPost[]
  communityPostComments CommunityPostComment[]
  pushSubscriptions   PushSubscription[]
  eventBlasts         EventBlast[]
  introRequestsMade   IntroRequest[]      @relation("IntroRequester")
  introRequestsAbout  IntroRequest[]      @relation("IntroTarget")
  introRequestsVia    IntroRequest[]      @relation("IntroVia")
  eventFeedback       EventFeedback[]

  @@index([email])
  @@index([supabaseId])
  @@index([googleId])
  @@index([username])
  @@index([role])
  @@index([isActive])
  @@map("users")
}

model Profile {
  id         String   @id @default(uuid())
  userId     String   @unique
  firstName  String
  lastName   String
  bio        String?  @db.Text
  status     String?
  company    String?
  position   String?
  location   String?
  avatar     String?
  skills     String[]
  interests  String[]
  lookingFor String[]
  /// "Open to" badges shown on the public card: HIRING / INVESTING / COFOUNDER / MENTORING
  openTo     String[] @default([])
  /// Pitch spotlight — the featured "what I'm building" block on the public card
  pitchName    String?
  pitchTagline String?
  pitchStage   String?
  pitchUrl     String?
  phone      String?
  twitter    String?
  linkedin   String?
  website    String?
  instagram  String?
  email      String?
  // Organizer payout account (legacy manual fields kept for migration safety).
  payoutUpiId         String?
  payoutAccountName   String?
  payoutBankName      String?
  payoutAccountNumber String?
  payoutIfsc          String?
  // Razorpay Route linked account for automated splits.
  razorpayAccountId     String?
  razorpayAccountStatus String? // created | activated | suspended
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("profiles")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  token     String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([token])
  @@map("refresh_tokens")
}

// Password reset tokens persisted in the DB so they survive container
// restarts (the prod Redis URL falls back to in-memory; tokens stored only
// there would be wiped on every deploy). We store a SHA-256 HASH of the
// emailed token, not the token itself — a DB leak doesn't expose live links.
model PasswordResetToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("password_reset_tokens")
}

model FounderCard {
  id         String     @id @default(uuid())
  userId     String     @unique
  memberId   String?    @unique
  status     CardStatus @default(PENDING)
  qrCode     String?    @db.Text
  qrCodeUrl  String?
  publicSlug String?    @unique
  nfcTagId   String?    @unique
  message    String?    @db.Text
  reason     String?    @db.Text
  appliedAt  DateTime   @default(now())
  reviewedAt DateTime?
  reviewedBy String?
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([status])
  @@map("founder_cards")
}

model Connection {
  id          String           @id @default(uuid())
  requesterId String
  receiverId  String
  status      ConnectionStatus @default(PENDING)
  eventId     String?
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  requester User             @relation("Requester", fields: [requesterId], references: [id], onDelete: Cascade)
  receiver  User             @relation("Receiver", fields: [receiverId], references: [id], onDelete: Cascade)
  event     Event?           @relation(fields: [eventId], references: [id], onDelete: SetNull)
  notes     ConnectionNote[]
  meta      ConnectionMeta[]

  @@unique([requesterId, receiverId])
  @@index([requesterId])
  @@index([receiverId])
  @@index([status])
  @@index([eventId])
  @@map("connections")
}

// "Ask a mutual to introduce you": requester asks `via` (a mutual connection)
// to introduce them to `target`, optionally in the context of an event.
// Status is a plain string (PENDING | DONE | DECLINED) — no PG enum needed.
model IntroRequest {
  id          String   @id @default(uuid())
  requesterId String
  targetId    String
  viaId       String
  eventId     String?
  message     String?  @db.VarChar(1000)
  status      String   @default("PENDING")
  createdAt   DateTime @default(now())

  requester User @relation("IntroRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  target    User @relation("IntroTarget", fields: [targetId], references: [id], onDelete: Cascade)
  via       User @relation("IntroVia", fields: [viaId], references: [id], onDelete: Cascade)

  @@index([viaId, status])
  @@index([requesterId])
  @@map("intro_requests")
}

model Event {
  id               String          @id @default(uuid())
  organizerId      String
  title            String
  description      String          @db.Text
  startDate        DateTime
  endDate          DateTime
  locationType     EventType       @default(IN_PERSON)
  address          String?
  city             String?
  state            String?
  country          String?
  pincode          String?
  meetingUrl       String?
  capacity         Int             @default(100)
  ticketPrice      Decimal?        @db.Decimal(10, 2)
  coverImage       String?
  tags             String[]
  status           EventStatus     @default(DRAFT)
  category         String?
  theme            String?         @default("default")
  slug             String?         @unique
  requiresApproval Boolean         @default(false)
  waitlistEnabled  Boolean         @default(true)
  visibility       EventVisibility @default(PUBLIC)
  timezone         String?         @default("UTC")
  ticketTypes      Json?
  checkInToken     String?         @unique
  checkInTokenExpiresAt DateTime?
  recapSentAt      DateTime?
  registrationDeadline DateTime?
  createdAt        DateTime        @default(now())
  updatedAt        DateTime        @updatedAt
  deletedAt        DateTime?

  communityId      String?

  organizer     User                @relation("Organizer", fields: [organizerId], references: [id])
  community     Community?          @relation(fields: [communityId], references: [id])
  registrations EventRegistration[]
  coupons       Coupon[]
  eventBlasts   EventBlast[]
  leads         Lead[]
  messages      EventMessage[]
  connections   Connection[]
  taps          EventTap[]
  savedBy       SavedEvent[]
  questions     EventQuestion[]
  speakers      EventSpeaker[]
  agendaItems   EventAgendaItem[]
  coorganizers  EventCoorganizer[]
  pageViews     EventPageView[]
  payments      Payment[]
  payouts       Payout[]
  feedback      EventFeedback[]

  @@index([organizerId])
  @@index([status])
  @@index([startDate])
  @@index([category])
  @@index([communityId])
  @@map("events")
}

// A recurring community an organizer runs — persistent member network across
// events. Events optionally belong to a community (Event.communityId).
model Community {
  id          String   @id @default(uuid())
  organizerId String
  name        String
  slug        String   @unique
  description String?  @db.Text
  avatar      String?
  coverImage  String?
  category    String?
  isPublic    Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  deletedAt   DateTime?

  organizer User              @relation("CommunityOwner", fields: [organizerId], references: [id], onDelete: Cascade)
  members   CommunityMember[]
  events    Event[]
  posts     CommunityPost[]

  @@index([organizerId])
  @@index([slug])
  @@map("communities")
}

// A post in a community's feed. Announcements are organizer/moderator posts
// that are pinned and fan out a notification to every member.
model CommunityPost {
  id             String    @id @default(uuid())
  communityId    String
  authorId       String
  body           String    @db.VarChar(4000)
  imageUrl       String?
  pinned         Boolean   @default(false)
  isAnnouncement Boolean   @default(false)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  community Community              @relation(fields: [communityId], references: [id], onDelete: Cascade)
  author    User                   @relation(fields: [authorId], references: [id], onDelete: Cascade)
  comments  CommunityPostComment[]

  // Feed query: one community's posts, pinned first then newest.
  @@index([communityId, pinned, createdAt])
  @@index([authorId])
  @@map("community_posts")
}

model CommunityPostComment {
  id        String   @id @default(uuid())
  postId    String
  authorId  String
  body      String   @db.VarChar(2000)
  createdAt DateTime @default(now())

  post   CommunityPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  author User          @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([postId, createdAt])
  @@index([authorId])
  @@map("community_post_comments")
}

model CommunityMember {
  id          String              @id @default(uuid())
  communityId String
  userId      String
  role        CommunityMemberRole @default(MEMBER)
  createdAt   DateTime            @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([communityId, userId])
  @@index([userId])
  @@map("community_members")
}

enum CommunityMemberRole {
  MEMBER
  MODERATOR
}

// Post-event feedback: one row per (event, attendee). rating 1–5 stars;
// nps 0–10 (optional) powers the organizer's NPS; comment free-text.
model EventFeedback {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  rating    Int
  nps       Int?
  comment   String?  @db.VarChar(2000)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([eventId])
  @@map("event_feedback")
}

// Web-push subscription (browser Push API) for a user/device.
model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("push_subscriptions")
}

// Per-event percentage discount code.
model Coupon {
  id          String    @id @default(uuid())
  eventId     String
  code        String
  discountPct Int // 1–100 percentage off
  maxUses     Int? // null = unlimited
  usedCount   Int       @default(0)
  expiresAt   DateTime?
  isActive    Boolean   @default(true)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([eventId, code])
  @@index([eventId])
  @@map("coupons")
}

// Record of every email blast sent (or scheduled) for an event.
model EventBlast {
  id          String    @id @default(uuid())
  eventId     String
  organizerId String
  subject     String
  body        String    @db.Text
  audience    String    @default("all") // all | registered | waitlist
  sent        Int       @default(0)
  scheduledAt DateTime?
  sentAt      DateTime?
  status      String    @default("sent") // sent | scheduled | failed
  createdAt   DateTime  @default(now())

  event     Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  organizer User  @relation(fields: [organizerId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([organizerId])
  @@index([scheduledAt, status])
  @@map("event_blasts")
}

model EventPageView {
  id        String   @id @default(uuid())
  eventId   String
  userId    String?
  sessionId String
  ipHash    String?
  userAgent String?
  referrer  String?
  isBot     Boolean  @default(false)
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@unique([eventId, sessionId])
  @@index([eventId, createdAt])
  @@index([userId])
  @@map("event_page_views")
}

model EventRegistration {
  id             String             @id @default(uuid())
  eventId        String
  userId         String
  status         RegistrationStatus @default(REGISTERED)
  eventRole      EventRole          @default(ATTENDEE)
  checkedIn      Boolean            @default(false)
  checkedInAt    DateTime?
  amountPaid     Decimal?           @db.Decimal(10, 2)
  paymentStatus  PaymentStatus?
  ticketTierId   String?
  ticketTierName String?
  couponCode     String?
  guestNote      String?            @db.Text
  registeredAt   DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  event    Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user     User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  answers  RegistrationAnswer[]
  payments Payment[]

  @@unique([eventId, userId])
  @@index([eventId])
  @@index([userId])
  // Serves "my registrations filtered by status" in a single index scan.
  @@index([userId, status])
  @@map("event_registrations")
}

model Payment {
  id                String        @id @default(uuid())
  userId            String
  eventId           String
  registrationId    String?
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  platformFee       Decimal?      @db.Decimal(10, 2)
  organizerEarning  Decimal?      @db.Decimal(10, 2)
  currency          String        @default("INR")
  ticketTierId      String?
  ticketTierName    String?
  couponCode        String?
  status            PaymentStatus @default(CREATED)
  notes             Json?
  // Razorpay Route transfer to organizer's linked account.
  transferId        String?
  transferStatus    String?  // pending | processed | failed
  transferAmount    Decimal? @db.Decimal(10, 2)
  transferredAt     DateTime?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  user         User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  event        Event              @relation(fields: [eventId], references: [id], onDelete: Restrict)
  registration EventRegistration? @relation(fields: [registrationId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([eventId])
  @@index([razorpayOrderId])
  @@index([registrationId, status])
  // Serves the Route-transfer retry cron: PAID payments still pending transfer.
  @@index([status, transferStatus])
  @@map("payments")
}

/// A lead captured from a public Tap Card's "leave your details" form. The
/// visitor may be anonymous (not a registered user), so we store raw contact.
model CardLead {
  id        String   @id @default(uuid())
  ownerId   String
  name      String
  email     String
  message   String?  @db.Text
  createdAt DateTime @default(now())

  owner User @relation("CardLeadsReceived", fields: [ownerId], references: [id], onDelete: Cascade)

  @@index([ownerId, createdAt])
  @@map("card_leads")
}

/// A rich content block shown on a user's Tap Card (pitch deck, demo video,
/// booking link, portfolio, etc.). type drives the icon; ordered by sortOrder.
model CardBlock {
  id        String   @id @default(uuid())
  userId    String
  type      String   @default("link")
  label     String
  url       String
  sortOrder Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, sortOrder])
  @@map("card_blocks")
}

/// A view of someone's public Tap Card. viewerId is null for anonymous visitors.
/// Powers the card-analytics dashboard (views, unique viewers, recent viewers).
model CardView {
  id        String   @id @default(uuid())
  ownerId   String
  viewerId  String?
  createdAt DateTime @default(now())

  owner  User  @relation("CardViewsReceived", fields: [ownerId], references: [id], onDelete: Cascade)
  viewer User? @relation("CardViewsMade", fields: [viewerId], references: [id], onDelete: SetNull)

  @@index([ownerId, createdAt])
  @@index([viewerId])
  @@map("card_views")
}

/// One-time purchase of the physical NFC Tap Card. Kept separate from Payment
/// (which is event-ticket-specific and requires an eventId).
model CardPurchase {
  id                String        @id @default(uuid())
  userId            String
  razorpayOrderId   String        @unique
  razorpayPaymentId String?
  razorpaySignature String?
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("INR")
  status              PaymentStatus    @default(CREATED)
  shippingAddress     Json?
  fulfillmentStatus   FulfillmentStatus @default(PENDING)
  trackingId          String?
  trackingProvider    String?
  dispatchedAt        DateTime?
  deliveredAt         DateTime?
  createdAt           DateTime         @default(now())
  updatedAt           DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([razorpayOrderId])
  @@index([fulfillmentStatus])
  @@map("card_purchases")
}

/// A founder's recurring membership subscription (Razorpay Subscriptions).
/// One per user. `currentPeriodEnd` drives entitlement: a CANCELLED member keeps
/// access until that date.
model Membership {
  id                     String           @id @default(uuid())
  userId                 String           @unique
  status                 MembershipStatus @default(NONE)
  plan                   String?          // 'monthly' | 'annual'
  razorpaySubscriptionId String?          @unique
  razorpayPlanId         String?
  currentPeriodEnd       DateTime?
  cancelAtPeriodEnd      Boolean          @default(false)
  createdAt              DateTime         @default(now())
  updatedAt              DateTime         @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([status])
  @@index([razorpaySubscriptionId])
  @@map("memberships")
}

model Payout {
  id          String       @id @default(uuid())
  organizerId String
  eventId     String?
  amount      Decimal      @db.Decimal(10, 2)
  status      PayoutStatus @default(PENDING)
  reference   String?
  note        String?
  paidAt      DateTime?
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt

  organizer User   @relation(fields: [organizerId], references: [id], onDelete: Cascade)
  event     Event? @relation(fields: [eventId], references: [id], onDelete: SetNull)

  @@index([organizerId])
  @@index([status])
  @@map("payouts")
}

model BlockedUser {
  id        String   @id @default(uuid())
  blockerId String
  blockedId String
  createdAt DateTime @default(now())

  blocker User @relation("BlocksMade", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked User @relation("BlocksReceived", fields: [blockedId], references: [id], onDelete: Cascade)

  @@unique([blockerId, blockedId])
  @@index([blockerId])
  @@index([blockedId])
  @@map("blocked_users")
}

model Gamification {
  id        String   @id @default(uuid())
  userId    String   @unique
  fkScore   Int      @default(0)
  level     Int      @default(1)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([fkScore])
  @@map("gamification")
}

model ScoreHistory {
  id        String   @id @default(uuid())
  userId    String
  action    String
  points    Int
  metadata  Json?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([createdAt])
  // Serves the score-history feed: one user's entries, newest first.
  @@index([userId, createdAt])
  @@map("score_history")
}

model Badge {
  id          String   @id @default(uuid())
  name        String   @unique
  description String
  icon        String
  condition   Json
  points      Int      @default(0)
  createdAt   DateTime @default(now())

  userBadges UserBadge[]

  @@map("badges")
}

model UserBadge {
  id       String   @id @default(uuid())
  userId   String
  badgeId  String
  earnedAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  badge Badge @relation(fields: [badgeId], references: [id])

  @@unique([userId, badgeId])
  @@index([userId])
  @@map("user_badges")
}

model Notification {
  id        String           @id @default(uuid())
  userId    String
  type      NotificationType
  title     String
  message   String
  data      Json?
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@index([createdAt])
  // Serves the notifications feed: one user's notifications, newest first.
  @@index([userId, createdAt])
  // Serves the unread-count badge: one user's unread rows.
  @@index([userId, isRead])
  @@map("notifications")
}

model Lead {
  id          String     @id @default(uuid())
  eventId     String
  attendeeId  String
  organizerId String
  status      LeadStatus @default(NEW)
  notes       String?    @db.Text
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  event     Event @relation(fields: [eventId], references: [id])
  attendee  User  @relation("AttendeeLead", fields: [attendeeId], references: [id])
  organizer User  @relation("OrganizerLead", fields: [organizerId], references: [id], onDelete: Cascade)

  @@unique([eventId, attendeeId])
  @@index([organizerId, status])
  @@index([status])
  @@map("leads")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     String   @db.Text
  type      String   @default("string")
  label     String?
  updatedAt DateTime @updatedAt

  @@map("platform_settings")
}

model AuditLog {
  id         String   @id @default(uuid())
  userId     String?
  action     String
  resource   String
  resourceId String?
  metadata   Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

model ConnectionNote {
  id           String   @id @default(uuid())
  connectionId String
  authorId     String
  body         String   @db.Text
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  author     User       @relation(fields: [authorId], references: [id], onDelete: Cascade)

  @@index([connectionId])
  @@index([authorId])
  @@map("connection_notes")
}

/// Per-user CRM metadata on a connection: private tags + a follow-up reminder.
/// Scoped to (connectionId, userId) so each side keeps their own.
model ConnectionMeta {
  id           String    @id @default(uuid())
  connectionId String
  userId       String
  tags         String[]  @default([])
  followUpAt   DateTime?
  followUpDone Boolean   @default(false)
  remindedAt   DateTime?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  connection Connection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([connectionId, userId])
  @@index([userId])
  @@index([followUpAt, followUpDone])
  @@map("connection_meta")
}

model SavedEvent {
  id        String   @id @default(uuid())
  userId    String
  eventId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  @@unique([userId, eventId])
  @@index([userId])
  @@map("saved_events")
}

model Conversation {
  id            String   @id @default(uuid())
  userAId       String
  userBId       String
  lastMessageAt DateTime @default(now())
  createdAt     DateTime @default(now())

  userA    User      @relation("ConvUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB    User      @relation("ConvUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages Message[]

  @@unique([userAId, userBId])
  @@index([userAId])
  @@index([userBId])
  @@index([lastMessageAt])
  @@map("conversations")
}

model Message {
  id             String    @id @default(uuid())
  conversationId String
  senderId       String
  body           String    @db.VarChar(4000)
  readAt         DateTime?
  createdAt      DateTime  @default(now())

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  sender       User         @relation(fields: [senderId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  // Serves chat history: one conversation's messages in time order.
  @@index([conversationId, createdAt])
  @@map("messages")
}

model EventQuestion {
  id        String   @id @default(uuid())
  eventId   String
  prompt    String
  type      String   @default("TEXT") // TEXT | SELECT | TEXTAREA
  options   Json?
  required  Boolean  @default(false)
  position  Int      @default(0)
  createdAt DateTime @default(now())

  event   Event                @relation(fields: [eventId], references: [id], onDelete: Cascade)
  answers RegistrationAnswer[]

  @@index([eventId])
  @@map("event_questions")
}

model RegistrationAnswer {
  id             String   @id @default(uuid())
  registrationId String
  questionId     String
  answer         String   @db.Text
  createdAt      DateTime @default(now())

  registration EventRegistration @relation(fields: [registrationId], references: [id], onDelete: Cascade)
  question     EventQuestion     @relation(fields: [questionId], references: [id], onDelete: Cascade)

  @@unique([registrationId, questionId])
  @@map("registration_answers")
}

model EventSpeaker {
  id        String   @id @default(uuid())
  eventId   String
  name      String
  title     String?
  company   String?
  bio       String?  @db.Text
  avatar    String?
  position  Int      @default(0)
  createdAt DateTime @default(now())

  event       Event             @relation(fields: [eventId], references: [id], onDelete: Cascade)
  agendaItems EventAgendaItem[]

  @@index([eventId])
  @@map("event_speakers")
}

model EventAgendaItem {
  id          String    @id @default(uuid())
  eventId     String
  startsAt    DateTime
  endsAt      DateTime?
  title       String
  description String?   @db.Text
  speakerId   String?
  createdAt   DateTime  @default(now())

  event   Event         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  speaker EventSpeaker? @relation(fields: [speakerId], references: [id], onDelete: SetNull)

  @@index([eventId])
  @@index([startsAt])
  @@map("event_agenda_items")
}

model EventCoorganizer {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  role      String   @default("COHOST")
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([eventId, userId])
  @@index([userId])
  @@map("event_coorganizers")
}

model ClaimToken {
  id        String    @id @default(uuid())
  userId    String
  tokenHash String    @unique
  expiresAt DateTime
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("claim_tokens")
}

model EventMessage {
  id        String   @id @default(uuid())
  eventId   String
  userId    String
  content   String   @db.Text
  createdAt DateTime @default(now())

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId])
  @@index([createdAt])
  @@map("event_messages")
}

model Report {
  id         String           @id @default(uuid())
  reporterId String
  targetType ReportTargetType
  targetId   String
  category   String
  reason     String           @db.Text
  status     ReportStatus     @default(OPEN)
  reviewerId String?
  resolution String?          @db.Text
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt

  reporter User  @relation("ReportsFiled", fields: [reporterId], references: [id], onDelete: Cascade)
  reviewer User? @relation("ReportsReviewed", fields: [reviewerId], references: [id])

  @@index([status])
  @@index([targetType, targetId])
  @@index([reporterId])
  @@map("reports")
}

model EventTap {
  id                   String    @id @default(uuid())
  eventId              String
  scannerUserId        String
  targetUserId         String
  method               TapMethod @default(QR)
  resultedInConnection Boolean   @default(false)
  createdAt            DateTime  @default(now())

  event   Event @relation(fields: [eventId], references: [id], onDelete: Cascade)
  scanner User  @relation("TapsInitiated", fields: [scannerUserId], references: [id], onDelete: Cascade)
  target  User  @relation("TapsReceived", fields: [targetUserId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([scannerUserId])
  @@index([targetUserId])
  @@map("event_taps")
}
