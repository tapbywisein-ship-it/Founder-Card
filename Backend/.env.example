# =============================================
# APPLICATION
# =============================================
NODE_ENV=development
PORT=3000
API_VERSION=v1

# =============================================
# DATABASE
# =============================================
# Supabase Postgres connection. Get the full URI from the Supabase dashboard →
# Project Settings → Database → Connection string ("URI" format). Replace the
# project ref, region, and password with your project's values.
# NOTE: if the password contains special chars (e.g. @), URL-encode them (@ = %40).
# IMPORTANT (scale): set connection_limit so Prisma doesn't exhaust the Supabase
# pgbouncer pool. Prisma otherwise opens (num_cpus*2)+1 connections per process;
# with several instances that overruns the pooler and produces cryptic timeouts.
# Size it as (pgbouncer pool ÷ number of app instances). connection_limit=5 is a
# safe single-instance default; also add pool_timeout to fail fast under load.
DATABASE_URL=postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:6543/postgres?pgbouncer=true&schema=public&connection_limit=5&pool_timeout=10
# Direct connection (used by Prisma migrate, NOT runtime queries — bypasses pgbouncer)
DIRECT_URL=postgresql://postgres.<project-ref>:<YOUR-DB-PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres?schema=public

# =============================================
# REDIS
# =============================================
REDIS_URL=redis://localhost:6379

# =============================================
# JWT
# =============================================
JWT_ACCESS_SECRET=your-super-secret-access-key-change-in-production-min-32-chars
JWT_REFRESH_SECRET=your-super-secret-refresh-key-change-in-production-min-32-chars
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# =============================================
# BCRYPT
# =============================================
BCRYPT_ROUNDS=12

# =============================================
# EMAIL (Resend — transactional email)
# =============================================
# Get an API key from https://resend.com/api-keys
RESEND_API_KEY=re_your_api_key
# Verified sender address (must be a domain verified in Resend)
EMAIL_FROM=noreply@tapbywisein.com

# =============================================
# AWS S3
# =============================================
AWS_ACCESS_KEY_ID=your-aws-access-key-id
AWS_SECRET_ACCESS_KEY=your-aws-secret-access-key
AWS_REGION=us-east-1
AWS_S3_BUCKET=golden-tap-uploads
AWS_S3_BASE_URL=https://golden-tap-uploads.s3.us-east-1.amazonaws.com

# =============================================
# CORS / FRONTEND
# =============================================
FRONTEND_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3001

# =============================================
# RATE LIMITING
# =============================================
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100

# =============================================
# LOGGING
# =============================================
LOG_LEVEL=info
LOG_DIR=logs

# =============================================
# FILE UPLOADS
# =============================================
UPLOAD_MAX_SIZE_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/jpg,image/png,image/webp,image/gif

# =============================================
# BULL QUEUES
# =============================================
BULL_REDIS_URL=redis://localhost:6379

# =============================================
# SUPABASE (Google OAuth + data)
# =============================================
# Get keys from: https://supabase.com/dashboard/project/<project-ref>/settings/api
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=<your-anon-public-key>
# SERVICE_ROLE_KEY must be copied from the Supabase dashboard (above URL).
# It is NEVER returned by the public API — paste it here manually.
SUPABASE_SERVICE_ROLE_KEY=<your-service-role-key>
