# Copy to .env and fill in. These are publishable client-side values
# (they ship in the JS bundle), but the file itself stays untracked so
# a real secret can never be committed by accident.
VITE_API_URL=http://localhost:3000/api/v1
VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_ANON_KEY=<publishable-anon-key>
# Google Cloud project key with "Maps JavaScript API" + "Places API (New)" enabled and billing on.
# Restrict it to your domains (HTTP referrers). Leaving it blank disables the venue search + map.
VITE_GOOGLE_MAPS_API_KEY=<maps-js-and-places-key>
